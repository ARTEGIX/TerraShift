# Local (non-Docker) dev overrides for main-service
PORT=4000
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
GENERAL_MONGO_URI=${ATLAS_MONGO_URI}/general_db?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
AGRONOMY_ENGINE_URL=http://agronomy-engine:8000
CORS_ORIGINS=http://localhost:3000,http://localhost
JWT_SECRET=dev-only-secret-change-me-please-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CACHE_TTL_SECONDS=86400
