# Local (non-Docker) dev overrides for agronomy-engine
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
LOOKUP_MONGO_URI=${ATLAS_MONGO_URI}/lookup_db?retryWrites=true&w=majority
GENERAL_MONGO_URI=${ATLAS_MONGO_URI}/general_db?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_TIMEOUT_SECONDS=10
GA_POPULATION=50
GA_GENERATIONS=30
GA_SEED=42
