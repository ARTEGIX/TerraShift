# Base URL of the TerraShift REST API.
# Production (Vercel) and local dev both use the team's deployed gateway:
NEXT_PUBLIC_API_BASE_URL=https://168.144.100.73.sslip.io/api
# To use a backend running on your own machine instead (docker compose), use:
# NEXT_PUBLIC_API_BASE_URL=http://localhost/api
# Default map centre (Sri Lanka)
NEXT_PUBLIC_MAP_CENTER_LAT=7.87
NEXT_PUBLIC_MAP_CENTER_LON=80.77
