# =====================================================================
# TerraShift — root environment (consumed by docker-compose.yml)
# Copy to `.env` and fill in secrets. NEVER commit `.env`.
# =====================================================================

# ---------- Shared infrastructure ----------
MONGO_URI=mongodb://mongo:27017/terrashift
REDIS_URL=redis://redis-cache:6379
CACHE_TTL_SECONDS=86400

# ---------- main-service (Node/Express, :4000) ----------
MAIN_SERVICE_PORT=4000
AGRONOMY_ENGINE_URL=http://agronomy-engine:8000
CORS_ORIGINS=http://localhost:3000,http://localhost
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Gemini explainability (optional — a deterministic template is used if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- agronomy-engine (Python/FastAPI, :8000) ----------
AGRONOMY_ENGINE_PORT=8000
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_TIMEOUT_SECONDS=10
NASA_HISTORY_YEARS=5
GA_POPULATION=60
GA_GENERATIONS=40
GA_SEED=42

# ---------- frontend (Next.js, :3000) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_MAP_CENTER_LAT=7.87
NEXT_PUBLIC_MAP_CENTER_LON=80.77
