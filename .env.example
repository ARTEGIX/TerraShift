# =====================================================================
# TerraShift — MongoDB Atlas Dual-Database & Local Redis Configuration
# Copy to `.env` and fill in secrets. NEVER commit `.env`.
# =====================================================================

# ---------- MongoDB Atlas Dual-Database Architecture ----------
# Base Atlas cluster connection string (no trailing slash or database name)
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Logical Database 1: general_db (main-service -> farms, simulation_runs, users)
GENERAL_MONGO_URI=${ATLAS_MONGO_URI}/general_db?retryWrites=true&w=majority

# Logical Database 2: lookup_db (agronomy-engine -> crops_catalog, soil_profiles, regional_saturation)
LOOKUP_MONGO_URI=${ATLAS_MONGO_URI}/lookup_db?retryWrites=true&w=majority

# ---------- Local Redis (~1km NASA Grid Cache & Explainability Cache) ----------
REDIS_URL=redis://redis-cache:6379
CACHE_TTL_SECONDS=86400

# ---------- main-service (Node/Express, :4000) ----------
MAIN_SERVICE_PORT=4000
AGRONOMY_ENGINE_URL=http://agronomy-engine:8000
CORS_ORIGINS=http://localhost:3000,http://localhost
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Gemini explainability (optional — deterministic template fallback used if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- agronomy-engine (Python/FastAPI, :8000) ----------
AGRONOMY_ENGINE_PORT=8000
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_TIMEOUT_SECONDS=10
GA_POPULATION=50
GA_GENERATIONS=30
GA_SEED=42

# ---------- frontend (Next.js, :3000) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_MAP_CENTER_LAT=7.87
NEXT_PUBLIC_MAP_CENTER_LON=80.77
